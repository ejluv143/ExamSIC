{
  "name": "examora",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "dev:web": "pnpm --filter @examora/web dev",
    "build:web": "pnpm --filter @examora/web build",
    "lint": "pnpm -r lint",
    "dev:runner": "npm --prefix backend/runner run dev",
    "runner:sandbox": "npm --prefix backend/runner run build:sandbox"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  }
}
