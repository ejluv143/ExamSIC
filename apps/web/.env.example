# Copy to .env.local and fill in. devenv sets API_URL.

# Internal URL of the API (apps/rpc). The web app calls it over RPC and forwards /api/auth/* to it.
API_URL=http://127.0.0.1:3001

# Optional. The API's address as browsers reach it, when that differs from API_URL (e.g. in production):
# live sessions open a WebSocket to it (/rpc/live; ws:// or wss:// is derived from the scheme). Defaults to
# API_URL. The API must allow this app's origin (BETTER_AUTH_URL, or LIVE_ALLOWED_ORIGINS on the API).
# PUBLIC_API_URL=https://api.example.com

# The image bucket as browsers reach it, the same value as S3_PUBLIC_ENDPOINT (else S3_ENDPOINT) on the API. The
# Content-Security-Policy only lets pages load images from and upload to this origin. devenv sets S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# Code runner (apps/runner). Optional: without it, code answers wait for the teacher.
# RUNNER_SECRET must match apps/runner/.env.
RUNNER_URL=http://127.0.0.1:4100
RUNNER_SECRET=

# OpenTelemetry (optional). Traces are exported over OTLP/HTTP only when the endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=examinus-web
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_TRACES_SAMPLER_ARG=1
