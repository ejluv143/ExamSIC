# Copy to .env.local and fill in. devenv sets API_URL.

# Internal URL of the API (apps/rpc). The web app calls it over RPC and forwards /api/auth/* to it.
API_URL=http://127.0.0.1:3001

# Optional. In production the login page hides the demo accounts unless this is true (e.g. on a demo server).
# SHOW_DEMO_ACCOUNTS=true

# The API's address as the browser reaches it (not the internal API_URL): live sessions open a WebSocket to it
# (/rpc/live; ws:// or wss:// is derived from the scheme). The API must allow this app's origin
# (BETTER_AUTH_URL, or LIVE_ALLOWED_ORIGINS on the API).
NEXT_PUBLIC_API_URL=http://localhost:3001
