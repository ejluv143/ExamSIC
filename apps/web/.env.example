# Copy to .env.local and fill in. devenv sets all of these except the Google pair.

# Postgres for Better Auth (and later the rest of the data).
DATABASE_URL=postgresql://127.0.0.1:5434/examora

# Signs login sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origin the app is served from; used for Google's OAuth redirect.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Set both to show "Continue with Google"; redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
