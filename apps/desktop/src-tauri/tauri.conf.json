{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Examinus",
  "version": "../package.json",
  "identifier": "ph.edu.sic.examinus.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Examinus Desktop",
    "longDescription": "The student client for Examinus quizzes and exams.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "perMachine" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
