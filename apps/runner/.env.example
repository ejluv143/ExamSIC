# Shared with apps/web (RUNNER_SECRET there). Generate one with: openssl rand -base64 32
RUNNER_SECRET=
PORT=4100
# Containers running at once. Each gets 1 CPU and 512 MB.
RUNNER_CONCURRENCY=2
# Jobs waiting for a container beyond this are answered 503 (busy); the API retries them. 0: none wait.
RUNNER_MAX_QUEUE=40
RUNNER_IMAGE=examinus-sandbox:1
# OpenTelemetry: leave empty to turn it off. OTLP/HTTP, e.g. http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=examinus-runner
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# OTEL_EXPORTER_OTLP_HEADERS=
