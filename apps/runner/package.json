{
  "name": "@examinus/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs students' code in throwaway Docker containers for Examinus's code questions.",
  "scripts": {
    "dev": "node --env-file=.env --watch server.mjs",
    "start": "node --env-file=.env server.mjs",
    "build:sandbox": "docker build -t examinus-sandbox:1 sandbox"
  },
  "engines": {
    "node": ">=22"
  }
}
