{
  "name": "@examinus/rpc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "plan:set": "bun src/database/set-plan.ts",
    "check:classroom": "bun src/checks/classroom-sync.ts",
    "test:fixture": "bun test/fixture/fixture.ts",
    "test:integration": "bun test test/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-presigned-post": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@better-auth/expo": "1.7.7",
    "@better-auth/mcp": "^1.7.7",
    "@effect/platform-bun": "^4.0.2",
    "@examinus/contract": "*",
    "@examinus/domain": "*",
    "@peculiar/x509": "^2.2.0",
    "better-auth": "^1.7.7",
    "cbor-x": "^1.6.8",
    "drizzle-orm": "^0.45.3",
    "effect": "^4.0.2",
    "reflect-metadata": "^0.2.2",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/sql.js": "^1.4.11",
    "bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
