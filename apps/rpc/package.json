    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/sql.js": "^1.4.11",
    "bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
