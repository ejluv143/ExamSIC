# Copy to .env and fill in. devenv sets all of these except the Google pair.

# Any PostgreSQL 17, local or hosted (Neon: the connection string with ?sslmode=require; see README "Database").
DATABASE_URL=postgresql://127.0.0.1:5434/examinus

# Dragonfly (any Redis-compatible server works): rate-limit counts, redeemed live tickets, presence, short-lived
# caches and the live and game event channels. Required. devenv runs one on 6390; docker compose on 6379.
REDIS_URL=redis://127.0.0.1:6390

# Signs login sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The web app's origin: browsers only talk to the web app, which forwards /api/auth/* here.
BETTER_AUTH_URL=http://localhost:3000
# The MCP server's endpoint (apps/mcp): the audience of the OAuth access tokens AI assistants get. Default: the MCP
# server's local address.
# MCP_RESOURCE_URL=http://127.0.0.1:3002/mcp

# Optional. Set both to show "Continue with Google"; redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. true: organizations may define roles of their own at /teacher/organization/roles (Better Auth's dynamic
# access control). Off by default: the fixed roles owner, admin, teacher and student.
ORG_CUSTOM_ROLES=false

# Optional: the desktop app (apps/desktop). DESKTOP_MIN_VERSION is the oldest build allowed to open a paper or start
# an attempt (raise it after a security fix); DESKTOP_RELEASES_REPO is the GitHub repository whose releases
# (tags desktop-vX.Y.Z) students download from.
DESKTOP_MIN_VERSION=0.0.0
DESKTOP_RELEASES_REPO=ejluv143/ExamSIC

# Optional: the mobile app. MOBILE_MIN_VERSION is the oldest build allowed to open a paper or start an attempt;
# MOBILE_UPDATE_URL is the store page an older build is sent to. MOBILE_APP_SCHEME is the app's URL scheme (Better
# Auth trusts it as an origin). Expo's web build, a browser, also needs its origin in LIVE_ALLOWED_ORIGINS.
MOBILE_MIN_VERSION=0.0.0
MOBILE_UPDATE_URL=
MOBILE_APP_SCHEME=examinus://

# Optional: device attestation (client.attest), which lets an exam take the mobile app on a verified device. A platform
# left empty refuses its devices. DESKTOP_ATTEST_KEY is the key built into the desktop app (it only raises the bar).
# Android: the Play Integrity package name and a Google service account key (JSON, on one line) allowed to decode
# integrity tokens. iOS: App Attest's `<team id>.<bundle id>`; APP_ATTEST_ENV=development accepts development keys.
DESKTOP_ATTEST_KEY=
PLAY_INTEGRITY_PACKAGE_NAME=
PLAY_INTEGRITY_SERVICE_ACCOUNT=
APP_ATTEST_APP_ID=
APP_ATTEST_ENV=

# Optional: the code runner (apps/runner) that grades Python, Java, C, C++, JavaScript and PHP answers. Set both,
# using the runner's own RUNNER_SECRET. Without them code answers wait for the teacher to grade them.
RUNNER_URL=
RUNNER_SECRET=

# Optional: S3-compatible storage (AWS S3, Cloudflare R2, Garage or MinIO) for question images and students'
# drawings. The bucket is private. Without these the API still starts, but images and drawings are unavailable.
# S3_ENDPOINT is empty for AWS S3. S3_PUBLIC_ENDPOINT is only needed when browsers reach the bucket at another
# address than the API does. devenv sets these for its Garage bucket (see devenv.nix).
S3_BUCKET=examinus
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:3910
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=GK0e5a0a00e5a0a00e5a0a00e
S3_SECRET_ACCESS_KEY=e5a0a00e5a0a00e5a0a00e5a0a00e5a0a00e5a0a00e5a0a00e5a0a00e5a0a00e

# Where the API listens. Keep HOST on loopback unless the web app runs on another machine.
PORT=3001
HOST=127.0.0.1

# Client addresses (exam IP allowlists, per-IP rate limits, integrity flags). The leftmost x-forwarded-for entry is
# never trusted. API_INTERNAL_SECRET is shared with the web app (same value in apps/web), which then may name the
# browser's address; required whenever the web app isn't on this machine (e.g. Vercel), otherwise every browser
# counts as the web server's address. Generate with: openssl rand -base64 32
API_INTERNAL_SECRET=
# How many proxies in front of the API append to x-forwarded-for (desktop and mobile apps call the API directly):
# 1 behind Fly's, Render's or Railway's proxy or one nginx; 0 when nothing is in front (the socket's address is used).
TRUSTED_PROXY_HOPS=0

# Optional. The web app's other origins (comma separated): allowed to open the live WebSocket and trusted by Better
# Auth on sign-in. Default: the origin of BETTER_AUTH_URL only. devenv adds the machine's network address.
LIVE_ALLOWED_ORIGINS=

# Optional: export traces, metrics and logs over OpenTelemetry (see README "Observability"). Empty means no export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=examinus-api
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_TRACES_SAMPLER_ARG=1
