# Copy to .env and fill in. devenv sets all of these except the Google pair.

DATABASE_URL=postgresql://127.0.0.1:5434/examora

# Signs login sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The web app's origin: browsers only talk to the web app, which forwards /api/auth/* here.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Set both to show "Continue with Google"; redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: the code runner (apps/runner) that grades Python, Java, C, C++, JavaScript and PHP answers. Set both,
# using the runner's own RUNNER_SECRET. Without them code answers wait for the teacher to grade them.
RUNNER_URL=
RUNNER_SECRET=

# Optional: S3-compatible storage (AWS S3, Cloudflare R2, or MinIO) for question images and students' drawings.
# The bucket is private. Without these the API still starts, but images and drawings are unavailable.
# S3_ENDPOINT is empty for AWS S3. S3_PUBLIC_ENDPOINT is only needed when browsers reach the bucket at another
# address than the API does (for example MinIO behind a different host name). devenv sets these for MinIO.
S3_BUCKET=examora
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=examora
S3_SECRET_ACCESS_KEY=examora-secret

# Where the API listens. Keep HOST on loopback unless the web app runs on another machine.
PORT=3001
HOST=127.0.0.1

# Optional. Browser origins allowed to open the live WebSocket (comma separated). Default: the origin of BETTER_AUTH_URL.
LIVE_ALLOWED_ORIGINS=
