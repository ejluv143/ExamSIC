{
  "name": "@examinus/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets an AI client act as a signed-in Examinus teacher through the RPC API.",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "serve": "bun src/http.ts",
    "dev:http": "bun --watch src/http.ts"
  },
  "dependencies": {
    "@examinus/contract": "*",
    "@examinus/domain": "*",
    "@modelcontextprotocol/server": "^2.3.1",
    "effect": "^4.0.2",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "bun": "^1.4.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
