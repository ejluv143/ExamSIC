# The API's origin (apps/rpc), as the phone or emulator reaches it. An http:// URL turns cleartext traffic on in the
# Android build; use https:// for anything you ship. In development on a device use the machine's LAN address.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
# The web app, linked from "Teachers use the web app" and from the sign-up note.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
