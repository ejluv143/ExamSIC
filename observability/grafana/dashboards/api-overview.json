      },
      "targets": [
        {
          "expr": "sum by (limit) (rate(examinus_rate_limited_total{job=\"examinus-api\", deployment_environment=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{limit}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 30,
