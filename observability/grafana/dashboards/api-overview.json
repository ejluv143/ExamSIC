      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(examinus_db_query_duration_ms_bucket{job=\"examinus-api\", deployment_environment=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
