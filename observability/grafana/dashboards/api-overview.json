      },
      "targets": [
        {
          "expr": "sum(rate(examinus_cache_reads_total{job=\"examinus-api\", deployment_environment=~\"$env\", result=\"hit\"}[$__rate_interval])) / sum(rate(examinus_cache_reads_total{job=\"examinus-api\", deployment_environment=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "hit ratio",
          "refId": "A",
          "datasource": {
